  "validation": {
    "episodes_per_coordinate_per_arm": 128,
    "required_coordinates": [
      0,
      1,
      2,
      3,
      4,
      5,
      6,
      7
    ],
    "categorical_min_accuracy": 0.95,
    "continuous_max_population_normalized_mse": 0.05,
    "population_variance": 0.3333333333333333,
