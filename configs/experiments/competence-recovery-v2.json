    {
      "stage": 2,
      "updates": 500,
      "train_assays": [
        "full_prefix_r0"
      ]
    },
    {
      "stage": 3,
      "updates": 500,
      "train_assays": [
        "full_prefix_r0",
        "full_prefix_r1"
      ]
    },
    {
      "stage": 4,
      "updates": 500,
      "train_assays": [
        "full_prefix_r0",
        "full_prefix_r1",
        "full_prefix_r2"
      ]
    },
    {
      "stage": 5,
      "updates": 1500,
      "train_assays": [
        "full_prefix_r1",
        "full_prefix_r2",
        "full_prefix_r4",
        "full_prefix_r8",
        "full_prefix_r16"
      ]
