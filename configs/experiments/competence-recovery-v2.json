    "cuda_matmul_allow_tf32": false,
    "cudnn_allow_tf32": false,
    "float32_matmul_precision": "highest",
    "deterministic_algorithms": true,
    "record_actual_flags": true
  },
  "schedule_rule": {
    "transition": "only at declared boundaries after current boundary checkpoint passes required gates",
    "failure": "stop and retain failure; no extensions or threshold changes",
    "stage4_counts": {
      "full_prefix_r0": 167,
      "full_prefix_r1": 167,
      "full_prefix_r2": 166
    },
    "stage4_equal_exposure_qualification": "deterministic cycling differs by one update because500 is not divisible by3; arms exactly balanced each paired update"
  },
  "selection": {
    "eligible_stage": 5,
    "short_assays": [
      "full_prefix_r0",
      "full_prefix_r1",
      "full_prefix_r2"
    ],
    "native_validation": true,
    "loss_horizons": [
      "R1",
      "R2",
      "R4",
      "R8",
      "R16"
    ],
    "weighting": "equal horizons and arms; categorical cross_entropy or continuous rawMSE",
    "order": [
      "minimum_balanced_validation_task_loss",
      "earliest_global_step",
      "frozen_lr_grid_order"
