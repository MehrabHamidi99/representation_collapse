  "maximum_fits": 12,
  "maximum_updates_per_fit": 3500,
  "scope": {
    "mode": "discovery only; not approval or confirmation",
    "inherited_snapshots": "preserve v1 code and checkpoint findings",
    "remaining_gate_b": "probes,causal interventions/shams,precision robustness,independent seeds,statisticsfreeze,native transfer remain separate",
