{
  "schema_version": 1,
  "kind": "qwen_research_leaf_worker_launch_recipe",
  "script": "code/ops/qwen_worker.py",
  "arguments": {
    "--project": "PROJECT_SOURCE_DIRECTORY",
    "--output": "NEW_PROJECT_SCRATCH_OUTPUT_DIRECTORY",
    "--cluster": "EXACT_LOCAL_SLURM_CONTROLLER_CLUSTER_NAME",
    "--max-hours": 24,
    "--max-calls": 24,
    "--interval": 60,
    "--research-interval": 3600,
    "--http-timeout": 180
  },
  "optional_repeated_arguments": {
    "--artifact-root": "EXPLICIT_PROJECT_ARTIFACT_DIRECTORY",
    "--job-id": "KNOWN_PROJECT_JOB_ID_ON_THIS_LOCAL_CONTROLLER_CLUSTER"
  },
  "required_environment_variable_names": [
    "QWEN_BASE_URL",
    "QWEN_MODEL",
    "CAIRN_API_KEY"
  ],
  "credential_delivery": "coordinator supplies environment through secure stdin; never write values to this file",
  "actions": "read project evidence and project job state; call Qwen; write proposals only",
  "request_policy": {
    "chat_template_kwargs": {"enable_thinking": false},
    "reasoning_effort": "low",
    "max_tokens": 2048,
    "requested_final_answer_token_target": 900,
    "accept_reasoning_as_final_answer": false,
    "reject_finish_reason_length": true
  },
  "scientific_acceptance": "pending independent coordinator review",
  "stop_conditions": [
    "runtime cap",
    "provider call-attempt cap",
    "three consecutive provider or schema errors",
    "termination signal"
  ],
  "note": "This is a launch recipe, not an automatically loaded worker configuration. Convert arguments to argv explicitly."
}
